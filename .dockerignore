# Baarali images build from the repo root (apps/baarali/packages/*/Dockerfile).
# Local installs and builds never enter the context: the image rebuilds them.
**/node_modules
**/dist
**/dist-headless
**/.env
.git
**/*.gif
# Native and packaged builds made on a developer's machine (the simulator's
# iOS project weighs over a gigabyte): no image uses them (02/10/2026).
apps/x/apps/mobile/ios
apps/x/apps/mobile/android
**/.expo
apps/x/apps/main/.package
apps/x/apps/main/out
